# -------------------------------------------------------------
# Nothing Web OS Backend - Environment Configuration
# -------------------------------------------------------------

# Server Port & Client URL
PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# -------------------------------------------------------------
# 1. Supabase Persistence Engine (PostgreSQL, Auth, Storage)
# -------------------------------------------------------------
# Find these in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_service_role_secret_key_here
SUPABASE_ANON_KEY=your_anon_public_key_here

# -------------------------------------------------------------
# 2. AI Intelligence Engine (Google Gemini or OpenAI)
# -------------------------------------------------------------
# Get a free Google AI Studio key: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) OpenAI API Key fallback
OPENAI_API_KEY=
